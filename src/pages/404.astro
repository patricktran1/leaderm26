---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
---

<Base
  title={`Not in the journal — ${site.name}`}
  description="That page is not part of this journal."
  noindex
>
  <Masthead />
  <main id="main" class="lost">
    <div class="shell lost__inner">
      <p class="label">Error 404</p>
      <h1 class="display">Not in the journal.</h1>
      <p class="lede">
        Nothing is filed at that address. The journal is a single page, so
        everything in it is one scroll away.
      </p>
      <a class="arrow-link" href="/"><span>Back to the journal</span> <span class="chev" aria-hidden="true">→</span></a>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .lost {
    display: grid;
    align-items: center;
    min-height: 68svh;
    padding-block: clamp(4rem, 12vw, 9rem);
  }
  .lost__inner { display: grid; gap: clamp(1.25rem, 2.6vw, 2rem); justify-items: start; }
  .lost .display { max-width: 14ch; }
</style>
