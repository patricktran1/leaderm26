---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import Hero from '../components/Hero.astro';
import Gathering from '../components/Gathering.astro';
import Journal from '../components/Journal.astro';
import Tables from '../components/Tables.astro';
import Notes from '../components/Notes.astro';
import Practice from '../components/Practice.astro';
import Colophon from '../components/Colophon.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Lightbox from '../components/Lightbox.astro';
import { gallery, missingFiles } from '../data/gallery';
import { photoIndexMeta } from '../data/photos';

// Build-time nudges. None of these stop a build; they are what to fix next.
const undescribed = gallery.filter((photo) => photo.altIsGenerated).map((photo) => photo.id);
if (undescribed.length > 0) {
  console.warn(
    `[photos] ${undescribed.length} photograph(s) still have generated alt text. ` +
      `Open /admin/photos to see them: ${undescribed.slice(0, 8).join(', ')}` +
      (undescribed.length > 8 ? ', …' : ''),
  );
}
if (missingFiles.length > 0) {
  console.warn(`[photos] indexed but not on disk, skipped: ${missingFiles.join(', ')}`);
}
for (const item of photoIndexMeta.unreadable) {
  console.warn(`[photos] could not read ${item.source} — ${item.reason}`);
}
---

<Base>
  <Masthead />
  <main id="main">
    <Hero />
    <Gathering />
    <Journal />
    <Tables />
    <Notes />
    <Practice />
    <Colophon />
  </main>
  <SiteFooter />
  <Lightbox />
</Base>

<script>
  import '../scripts/ui';
</script>
