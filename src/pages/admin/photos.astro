---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { gallery } from '../../data/gallery';
import { captureParts, photoIndexMeta } from '../../data/photos';
import { conference } from '../../data/site';

const needsAlt = gallery.filter((photo) => photo.altIsGenerated);
const needsCaption = gallery.filter((photo) => photo.captionIsMissing);
const superseded = gallery.flatMap((photo) =>
  photo.supersedes.map((source) => ({ id: photo.id, source })),
);

const untouched = gallery.filter((photo) => !photo.hasOverride);
const waiting = gallery.filter((photo) => photo.altIsGenerated || photo.captionIsMissing);
/** One sitting's worth. A hundred photographs is not a batch, it is a weekend. */
const BATCH = 30;
const batch = waiting.slice(0, BATCH);
const more = waiting.length - batch.length;

const clock = (iso: string | null): string => {
  const parts = captureParts(iso);
  return parts ? `${parts.day} ${parts.time}` : 'no capture time';
};

/**
 * Everything Claude needs to write the editorial treatment for a batch, in one
 * block: what to do, the rule that matters, and a line per photograph carrying
 * the facts the file already knows. Nothing here describes what is in a frame —
 * that is the one thing metadata cannot tell you and the reason the photographs
 * themselves have to be looked at.
 */
const brief = [
  `${batch.length} photograph${batch.length === 1 ? '' : 's'} from LEADderm 2026 need editorial treatment.`,
  '',
  'Open each file listed below, look at it, and write:',
  '  caption — a short editorial line, in the voice already in photos/captions.json',
  '  alt     — what is actually in the frame, for someone who cannot see it',
  '',
  'Describe only what is in the photograph. Never name a person. Never invent a',
  'session, a speaker, a statistic or anything else about the conference.',
  'Add the result to the "photos" object in photos/captions.json, then run the checks.',
  '',
  ...batch.map((photo) =>
    [
      `${photo.id}  ${photo.source}  ${photo.sourceWidth}x${photo.sourceHeight}  ` +
        `${clock(photo.takenAt)}  ${photo.camera ?? 'camera unknown'}` +
        (photo.featured ? '  [opens the journal]' : ''),
      `    caption: ${photo.captionIsMissing ? '—' : photo.caption}`,
      `    alt:     ${photo.altIsGenerated ? '—' : photo.alt}`,
    ].join('\n'),
  ),
].join('\n');

/** The same gaps as bare JSON, for filling in by hand. */
const draft = Object.fromEntries(
  batch.map((photo) => [
    photo.id,
    {
      caption: photo.captionIsMissing ? '' : photo.caption,
      alt: photo.altIsGenerated ? '' : photo.alt,
    },
  ]),
);

/** What still wants attention, said in three words rather than a paragraph. */
const marks = (photo: (typeof gallery)[number]): string[] => {
  const out: string[] = [];
  if (!photo.hasOverride) out.push('untouched');
  if (photo.captionIsMissing) out.push('needs caption');
  if (photo.altIsGenerated) out.push('needs alt');
  if (out.length === 0) out.push('written');
  if (photo.featured) out.push('opens the journal');
  return out;
};

/**
 * Pins are seat numbers. A block of pinned frames with no capture time holds
 * the front of the journal, which is right until the day's own photographs
 * arrive — so the desk says so plainly rather than leaving it to be discovered.
 */
const pinned = gallery.filter((photo) => photo.pinnedAt !== null);
const pinsBlockDated =
  pinned.length > 0 &&
  pinned.every((photo) => !photo.takenAt) &&
  gallery.some((photo) => photo.takenAt);

const dt = (iso: string | null): string => (iso ? iso.replace('T', ' ').replace(/\..*$/, '') : '—');
---

<Base title="Photo desk — LEADderm 2026 Field Notes" description="Ingestion status." noindex>
  <main id="main" class="desk">
    <div class="shell">
      <p class="label">Photo desk</p>
      <h1 class="h2">{gallery.length} photograph{gallery.length === 1 ? '' : 's'} on the page.</h1>
      <p class="prose">
        Everything here is generated from the <code>photos</code> folder. This page is not linked
        from the journal and is not indexed — it exists so the gaps are visible.
      </p>

      <dl class="stats">
        <div><dt>Files read</dt><dd>{photoIndexMeta.counts.files}</dd></div>
        <div><dt>Published</dt><dd>{gallery.length}</dd></div>
        <div><dt>Superseded</dt><dd>{photoIndexMeta.counts.superseded}</dd></div>
        <div>
          <dt>Unreadable</dt>
          <dd class:list={[{ flag: photoIndexMeta.counts.unreadable > 0 }]}>
            {photoIndexMeta.counts.unreadable}
          </dd>
        </div>
        <div><dt>Need alt text</dt><dd class:list={[{ flag: needsAlt.length > 0 }]}>{needsAlt.length}</dd></div>
        <div><dt>Need a caption</dt><dd class:list={[{ flag: needsCaption.length > 0 }]}>{needsCaption.length}</dd></div>
        <div><dt>Untouched</dt><dd class:list={[{ flag: untouched.length > 0 }]}>{untouched.length}</dd></div>
      </dl>

      {(photoIndexMeta.captions.error || photoIndexMeta.captions.problems.length > 0) && (
        <section class="block">
          <h2 class="h3">The captions file needs a look</h2>
          {photoIndexMeta.captions.error && (
            <p class="prose">
              <strong>Ignored:</strong> {photoIndexMeta.captions.error}. Every photograph is
              publishing without its caption until this is fixed — nothing else is affected.
            </p>
          )}
          {photoIndexMeta.captions.problems.length > 0 && (
            <ul class="plain">
              {photoIndexMeta.captions.problems.map((problem) => (
                <li>{problem}</li>
              ))}
            </ul>
          )}
        </section>
      )}

      {photoIndexMeta.captions.strays && photoIndexMeta.captions.strays.length > 0 && (
        <section class="block">
          <h2 class="h3">Pasted a level too high</h2>
          <p class="prose">
            These were written outside the <code>photos</code> block. They have been used anyway,
            but move them inside it when you get a moment so the file stays readable.
          </p>
          <ul class="plain">
            {photoIndexMeta.captions.strays.map((key) => (
              <li><code>{key}</code></li>
            ))}
          </ul>
        </section>
      )}

      {pinsBlockDated && (
        <section class="block">
          <h2 class="h3">The pinned frames are holding the opening</h2>
          <p class="prose">
            {pinned.length} photograph{pinned.length === 1 ? '' : 's'} carry an <code>order</code>{' '}
            and no capture time, so they hold seats {1}–{pinned.length} and everything shot at the
            conference runs after them. That is the curated opening working as intended. To let the
            whole journal sort itself by the clock, delete the <code>order</code> lines from{' '}
            <code>photos/captions.json</code>, or give those frames a{' '}
            <code>takenAt</code> of <code>2026-08-29T14:20</code>.
          </p>
        </section>
      )}

      {photoIndexMeta.unreadable.length > 0 && (
        <section class="block">
          <h2 class="h3">Could not be read</h2>
          <p class="prose">
            These were skipped and the build carried on. Everything else published normally.
          </p>
          <ul class="plain">
            {photoIndexMeta.unreadable.map((item) => (
              <li><code>{item.source}</code> — {item.reason}</li>
            ))}
          </ul>
        </section>
      )}

      {superseded.length > 0 && (
        <section class="block">
          <h2 class="h3">Replaced by a better copy</h2>
          <p class="prose">
            A higher-resolution version of each of these arrived, so the older file is no longer
            published. It is safe to delete from the repository whenever you like.
          </p>
          <ul class="plain">
            {superseded.map((item) => (
              <li><code>{item.source}</code> → published as <strong>{item.id}</strong></li>
            ))}
          </ul>
        </section>
      )}

      {waiting.length > 0 && (
        <section class="block">
          <h2 class="h3">Hand this batch to Claude</h2>
          <p class="prose">
            Everything Claude needs for {more > 0 ? `the next ${batch.length} of the ${waiting.length}` : `the ${batch.length}`}{' '}
            frame{batch.length === 1 ? '' : 's'} still on automatic text: the instruction, the rule
            that matters, and the facts each file already carries. It has to look at the
            photographs to write the rest — that is the point, and it is why nothing here guesses
            at what is in them.
          </p>
          {more > 0 && (
            <p class="prose">
              Thirty is one sitting. When these are written, reload this page and the next
              {' '}{Math.min(more, BATCH)} are here.
            </p>
          )}
          <button class="copy" type="button" data-copy="brief">Copy the brief</button>
          <pre class="draft" data-block="brief" tabindex="0" role="region" aria-label="Editorial brief">{brief}</pre>
        </section>
      )}

      {Object.keys(draft).length > 0 && (
        <section class="block">
          <h2 class="h3">Or fill it in by hand</h2>
          <p class="prose">
            The same gaps as bare JSON, for the one caption you want to write yourself. It goes in
            the <code>photos</code> object in <code>photos/captions.json</code>.
          </p>
          <button class="copy" type="button" data-copy="json">Copy the JSON</button>
          <pre class="draft" data-block="json" tabindex="0" role="region" aria-label="Caption block">{JSON.stringify(draft, null, 2)}</pre>
        </section>
      )}

      <section class="block">
        <h2 class="h3">Every frame</h2>
        <ol class="sheet">
          {gallery.map((photo, i) => (
            <li class="sheet__item">
              <div class="sheet__frame frame">
                <Image src={photo.image} alt="" widths={[180]} sizes="180px" quality={70} loading="lazy" />
              </div>
              <div class="sheet__meta">
                <p class="sheet__id"><strong>{photo.id}</strong> <span>#{i + 1}</span></p>
                <p class="sheet__marks">
                  {marks(photo).map((mark) => (
                    <span class:list={['mark', { 'mark--gap': mark.startsWith('needs') || mark === 'untouched' }]}>
                      {mark}
                    </span>
                  ))}
                </p>
                <p class:list={[{ sheet__gap: photo.captionIsMissing }]}>
                  {photo.captionIsMissing ? 'caption: none' : `caption: ${photo.caption}`}
                </p>
                <p class="sheet__dim">
                  {photo.sourceWidth}×{photo.sourceHeight} source · {photo.image.width}×
                  {photo.image.height} master · {photo.weight}
                </p>
                <p class="sheet__dim">{dt(photo.takenAt)} · {photo.camera ?? 'camera unknown'}</p>
                <p class="sheet__dim"><code>{photo.source}</code></p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <p class="prose foot">
        Index generated {dt(photoIndexMeta.generatedAt)} · masters capped at
        {' '}{photoIndexMeta.maxEdge}px · <a class="link" href="/">back to the journal</a> ·
        {' '}<a class="link" href={conference.official} target="_blank" rel="noopener noreferrer">leadderm.org</a>
      </p>
    </div>
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const block = document.querySelector<HTMLElement>(`[data-block="${button.dataset.copy}"]`);
    const label = button.textContent ?? 'Copy';
    button.addEventListener('click', async () => {
      if (!block?.textContent) return;
      try {
        await navigator.clipboard.writeText(block.textContent);
        button.textContent = 'Copied';
        window.setTimeout(() => (button.textContent = label), 1600);
      } catch {
        button.textContent = 'Select it manually';
      }
    });
  });
</script>

<style>
  .desk { padding-block: clamp(2.5rem, 6vw, 5rem) 6rem; }
  .desk .h2 { margin-block: 0.5rem 1rem; }
  .desk code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
    color: var(--ink-2);
    background: var(--paper-sunk);
    padding: 0.1em 0.35em;
  }

  .stats {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    border-top: 1px solid var(--ink);
  }
  .stats > div { padding-block: 0.9rem; border-bottom: 1px solid var(--rule); }
  .stats dt { font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); }
  .stats dd { font-family: var(--serif); font-size: 1.5rem; margin-top: 0.2rem; }
  .stats .flag { color: #8a3d1f; }

  .block { margin-top: clamp(2.5rem, 5vw, 4rem); display: grid; gap: 0.85rem; justify-items: start; }
  .plain { display: grid; gap: 0.4rem; font-size: 0.875rem; color: var(--ink-2); }

  .copy {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--ink);
    padding: 0 0 0.18em;
    min-height: 2.75rem;
    cursor: pointer;
  }
  .draft {
    width: 100%;
    max-height: 22rem;
    overflow: auto;
    background: var(--night);
    color: var(--ink-on-night);
    padding: 1rem 1.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
    margin: 0;
  }

  .sheet { display: grid; gap: 1.25rem; width: 100%; }
  .sheet__item {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .sheet__frame { width: 5.5rem; aspect-ratio: 1; }
  .sheet__meta { display: grid; gap: 0.2rem; font-size: 0.8125rem; color: var(--ink-2); min-width: 0; }
  .sheet__meta p { overflow-wrap: anywhere; }
  .sheet__id span { color: var(--ink-3); }
  .sheet__gap { color: #8a3d1f; }
  .sheet__marks { display: flex; flex-wrap: wrap; gap: 0.3rem 0.75rem; }
  .mark {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .mark--gap { color: #8a3d1f; }
  .sheet__dim { color: var(--ink-3); font-size: 0.8125rem; }

  .foot { margin-top: 3rem; font-size: 0.8125rem !important; }
</style>
