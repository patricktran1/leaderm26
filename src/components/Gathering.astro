---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { conference } from '../data/site';
import { byPhotoId } from '../data/gallery';

const grounded = byPhotoId('DSC01778');

/** The meeting's four stated objectives, as published on leadderm.org/about. */
const objectives = [
  {
    n: '01',
    t: 'Lead',
    d: 'Frameworks and practical tools for leading effectively and inclusively — the skills that decide whether good clinical work survives contact with an organization.',
  },
  {
    n: '02',
    t: 'Belong',
    d: 'A network built for connection, collaboration and belonging, rather than for badge-scanning in an exhibit hall.',
  },
  {
    n: '03',
    t: 'Represent',
    d: 'The case that diversity is not adjacent to patient care but a determinant of it — who is in the room changes what the room can see.',
  },
  {
    n: '04',
    t: 'Advance',
    d: 'Insight and resources for career advancement, delivered through workshops and conversation instead of a lecture-hall broadcast.',
  },
];
---

<section class="section rule-top" id="gathering">
  <div class="shell">
    <SectionHead num="01" label="The gathering" title="A conference about the part nobody grades you on.">
      <p class="prose">
        LEADderm describes itself as a new kind of dermatology conference, built around {conference.positioning}.
        It is run by the {conference.organizer}, and the third annual meeting carries a title —
        <strong>{conference.theme}</strong> — about finding the values a career gets built on
        before choosing what to build on them.
      </p>
    </SectionHead>

    <div class="gathering__body">
      <ol class="objectives">
        {objectives.map((o, i) => (
          <li class="objective reveal" style={`--reveal-delay:${i * 70}ms`}>
            <span class="objective__n label">{o.n}</span>
            <h3 class="objective__t h3">{o.t}</h3>
            <p class="objective__d">{o.d}</p>
          </li>
        ))}
      </ol>

      <figure class="grounded reveal">
        <div class="frame grounded__frame">
          <Image
            src={grounded.image}
            alt={grounded.alt}
            widths={[400, 480]}
            sizes="(min-width: 62rem) 22rem, calc(100vw - 2.5rem)"
            quality={82}
            loading="lazy"
          />
        </div>
        <figcaption>
          <p class="serif-note">
            An easel by the door asked everyone the same question. By mid-morning it was
            covered in answers.
          </p>
          <p class="grounded__meta">{grounded.caption} · {conference.venue}</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .gathering__body {
    margin-top: clamp(3rem, 7vw, 5.5rem);
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  @media (min-width: 62rem) {
    .gathering__body {
      grid-template-columns: minmax(0, 1fr) clamp(17rem, 22vw, 22rem);
      align-items: start;
    }
  }

  .objectives {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 40rem) {
    .objectives { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 4vw, 3.5rem); }
  }

  .objective {
    padding-block: clamp(1.4rem, 3vw, 2rem);
    border-bottom: 1px solid var(--rule);
    display: grid;
    gap: 0.5rem;
  }
  .objective__n { color: var(--ink-3); }
  .objective__d {
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--ink-2);
    max-width: 30rem;
  }

  .grounded { margin: 0; }
  .grounded__frame { aspect-ratio: 2 / 3; }
  .grounded figcaption { margin-top: 1.1rem; display: grid; gap: 0.75rem; }
  .grounded__meta { font-size: 0.75rem; color: var(--ink-3); letter-spacing: 0.01em; }
</style>
