---
import { Image } from 'astro:assets';
import { conference, author } from '../data/site';
import { heroPhoto } from '../data/gallery';

// Any photograph marked `"featured": true` in captions.json opens the journal;
// these are only the fallbacks, so the slot never depends on one filename.
const cover = heroPhoto('IMG_7885', 'DSC01757');

const dateline = [
  conference.dates,
  conference.venue,
  `${conference.edition} meeting`,
  `Theme: ${conference.theme}`,
];
---

<section class="hero" id="top">
  <div class="shell hero__grid">
    <div class="hero__type">
      <p class="label reveal">An independent journal, published on site</p>
      <h1 class="display reveal" style="--reveal-delay:80ms">
        The other half<br />of the training.
      </h1>
      <p class="lede reveal" style="--reveal-delay:160ms">
        LEADderm gathers dermatologists, physician associates, nurse&nbsp;practitioners and
        industry partners around the part of the job medicine rarely teaches: leadership,
        community, and the ground you stand on.
      </p>
      <p class="byline reveal" style="--reveal-delay:200ms">
        Photographs and notes by {author.name}
      </p>
    </div>

    {cover && (
      <figure class="hero__figure reveal" style="--reveal-delay:200ms">
        <div class="frame hero__frame">
          <Image
            src={cover.image}
            alt={cover.alt}
            widths={[400, 600, 864]}
            sizes="(min-width: 62rem) 27rem, min(26rem, calc(100vw - 2.5rem))"
            quality={82}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption class="hero__cap">{cover.caption}</figcaption>
      </figure>
    )}
  </div>

  <div class="shell">
    <p class="dateline reveal">
      {dateline.map((item, i) => (
        <span class="dateline__item">
          {item}
          {i < dateline.length - 1 && <span class="dateline__sep" aria-hidden="true">·</span>}
        </span>
      ))}
    </p>
  </div>
</section>

<style>
  .hero { padding-block: clamp(2.25rem, 6vw, 5rem) 0; }

  .byline {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-3);
    max-width: 30rem;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.25rem, 5vw, 4rem);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) clamp(19rem, 27vw, 27rem);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }

  .hero__type { display: grid; gap: clamp(1.25rem, 2.6vw, 2rem); }
  .hero .display { margin-block: 0.1em -0.06em; }
  @media (min-width: 62rem) {
    /* The headline shares the row with the photograph, so it scales off the
       column rather than the viewport. */
    .hero .display { font-size: clamp(3rem, 5.8vw, 6.5rem); }
  }

  /* The photographic masters top out at 600px on the long edge, so single
     column layouts cap the frame rather than stretching it across a tablet. */
  .hero__figure { margin: 0; max-width: 26rem; }
  @media (min-width: 62rem) { .hero__figure { max-width: none; } }
  /* Cropped past the ceiling: the frame is 4:5 and biased down the picture so
     the screen and the speaker carry it, not the light fittings. */
  .hero__frame { aspect-ratio: 4 / 5; }
  .hero__frame :global(img) { object-position: 50% 64%; }
  .hero__frame :global(img) {
    transform: scale(1.001);
  }

  .hero__cap {
    margin-top: 0.85rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    letter-spacing: 0.01em;
    color: var(--ink-3);
    text-wrap: balance;
  }

  .dateline {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-block: clamp(0.9rem, 1.8vw, 1.25rem);
    border-top: 1px solid var(--ink);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0;
    font-family: var(--serif);
    font-size: clamp(0.9375rem, 1.2vw, 1.125rem);
    line-height: 1.35;
    letter-spacing: -0.005em;
  }
  .dateline__item { white-space: nowrap; }
  /* On a narrow screen a wrapped item would begin with its separator, so the
     dateline becomes a stacked list instead. */
  @media (max-width: 34rem) {
    .dateline { display: grid; gap: 0.2rem; }
    .dateline__sep { display: none; }
  }
  /* The separator travels inside its item's nowrap span, so it can never be
     left alone at the start or end of a wrapped line. */
  .dateline__sep {
    color: var(--ink-3);
    margin-inline: 0.65em 0.7em;
  }
</style>
