---
import { getImage } from 'astro:assets';
import { gallery } from '../data/gallery';
import { CATEGORY_LABEL } from '../data/photos';

const slides = await Promise.all(
  gallery.map(async (photo) => {
    const full = await getImage({
      src: photo.image,
      width: photo.image.width,
      format: 'webp',
      quality: 88,
    });
    return {
      src: full.src,
      w: photo.image.width,
      h: photo.image.height,
      alt: photo.alt,
      caption: photo.caption,
      note: photo.note ?? '',
      category: CATEGORY_LABEL[photo.category],
    };
  }),
);
---

<div class="lb" id="lightbox" hidden>
  <div class="lb__scrim" data-lb-dismiss></div>

  <div class="lb__panel" data-lb-dismiss role="dialog" aria-modal="true" aria-label="Photograph viewer" tabindex="-1">
    <div class="lb__bar">
      <span class="lb__count" data-lb-count aria-live="polite"></span>
      <button class="lb__close" type="button" data-lb-close aria-label="Close viewer">
        Close <span aria-hidden="true">×</span>
      </button>
    </div>

    <div class="lb__stage" data-lb-stage data-lb-dismiss>
      <button class="lb__nav lb__nav--prev" type="button" data-lb-prev aria-label="Previous photograph">
        <span aria-hidden="true">←</span>
      </button>
      <figure class="lb__figure" data-lb-dismiss>
        <img data-lb-image alt="" decoding="async" />
      </figure>
      <button class="lb__nav lb__nav--next" type="button" data-lb-next aria-label="Next photograph">
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div class="lb__meta">
      <p class="lb__caption" data-lb-caption></p>
      <p class="lb__note" data-lb-note></p>
    </div>
  </div>
</div>

<script type="application/json" id="lightbox-data" set:html={JSON.stringify(slides)} is:inline />

<style>
  .lb { position: fixed; inset: 0; z-index: 90; }
  .lb[hidden] { display: none; }

  .lb__scrim {
    position: absolute;
    inset: 0;
    background: rgba(12, 13, 15, 0.94);
    opacity: 0;
    transition: opacity 0.28s var(--ease);
  }
  .lb[data-open] .lb__scrim { opacity: 1; }

  .lb__panel {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    padding: 0.75rem clamp(0.75rem, 3vw, 2rem) max(0.75rem, env(safe-area-inset-bottom));
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 0.28s var(--ease), transform 0.34s var(--ease);
  }
  .lb[data-open] .lb__panel { opacity: 1; transform: none; }
  .lb__panel:focus { outline: none; }

  .lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #cfd1d3;
    min-height: 2.5rem;
  }
  .lb__count {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .lb__close {
    background: none;
    border: 1px solid #3a3d42;
    border-radius: 999px;
    color: #e7e5e1;
    padding: 0.65rem 1rem;
    min-height: 2.75rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }
  .lb__close:hover { border-color: #6b6f75; }

  .lb__stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.25rem, 2vw, 1.5rem);
    min-height: 0;
    padding-block: 0.75rem;
  }

  .lb__figure {
    margin: 0;
    height: 100%;
    display: grid;
    place-items: center;
    min-height: 0;
  }
  .lb__figure img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .lb__figure img[data-ready] { opacity: 1; }

  .lb__nav {
    background: none;
    border: 0;
    color: #8d9096;
    font-size: 1.15rem;
    line-height: 1;
    padding: 0.9rem 0.55rem;
    cursor: pointer;
    transition: color 0.25s var(--ease);
  }
  .lb__nav:hover { color: #fff; }

  .lb__meta {
    color: #cfd1d3;
    display: grid;
    gap: 0.25rem;
    padding-block: 0.75rem 0.25rem;
    min-height: 3rem;
  }
  .lb__caption {
    font-family: var(--serif);
    font-size: clamp(1rem, 2.4vw, 1.25rem);
    font-weight: 300;
    color: #f2f0ec;
    letter-spacing: -0.01em;
  }
  .lb__note { font-size: 0.8125rem; color: #91949a; max-width: 42rem; }

  @media (max-width: 40rem) {
    .lb__nav { display: none; }
    .lb__stage { grid-template-columns: minmax(0, 1fr); }
  }
</style>
