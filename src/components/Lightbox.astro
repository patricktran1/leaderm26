---
import { getImage } from 'astro:assets';
import { gallery } from '../data/gallery';
import { CATEGORY_LABEL } from '../data/photos';

/** The viewer panel tops out at 62rem, so 2000px covers a 2x screen. */
const VIEWER_MAX = 2000;

const slides = await Promise.all(
  gallery.map(async (photo) => {
    const full = await getImage({
      src: photo.image,
      width: Math.min(photo.image.width, VIEWER_MAX),
      format: 'webp',
      quality: 86,
    });
    return {
      id: photo.id,
      src: full.src,
      w: full.attributes.width ?? photo.image.width,
      h: full.attributes.height ?? photo.image.height,
      alt: photo.alt,
      caption: photo.caption,
      note: photo.note ?? photo.meta,
      category: CATEGORY_LABEL[photo.category],
    };
  }),
);
---

<div class="lb" id="lightbox" hidden>
  <div class="lb__scrim" data-lb-dismiss></div>

  <div class="lb__panel" data-lb-dismiss role="dialog" aria-modal="true" aria-label="Photograph viewer" tabindex="-1">
    <div class="lb__bar" data-lb-dismiss>
      <button class="lb__close" type="button" data-lb-close aria-label="Close viewer">
        <span class="lb__close-label">Close</span> <span aria-hidden="true">×</span>
      </button>
    </div>

    <div class="lb__stage" data-lb-stage data-lb-dismiss>
      <figure class="lb__figure" data-lb-dismiss>
        <img data-lb-image alt="" decoding="async" />
      </figure>
    </div>

    <div class="lb__foot">
      <div class="lb__meta" aria-live="polite">
        <p class="lb__caption" data-lb-caption></p>
        <p class="lb__note" data-lb-note></p>
      </div>
      <div class="lb__controls">
        <button class="lb__nav" type="button" data-lb-prev aria-label="Previous photograph">
          <span aria-hidden="true">←</span>
        </button>
        <span class="lb__count" data-lb-count></span>
        <button class="lb__nav" type="button" data-lb-next aria-label="Next photograph">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="lightbox-data" set:html={JSON.stringify(slides)} is:inline />

<style>
  .lb {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: #0a0b0d;
    opacity: 0;
    transition: opacity 0.24s var(--ease);
  }
  .lb[data-open] { opacity: 1; }
  .lb[hidden] { display: none; }

  .lb__scrim { position: absolute; inset: 0; }

  .lb__panel {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    width: min(100%, 62rem);
    margin-inline: auto;
    padding: 0.5rem clamp(0.75rem, 3vw, 2rem) max(0.75rem, env(safe-area-inset-bottom));
    transform: scale(0.985);
    transition: transform 0.34s var(--ease);
  }
  .lb[data-open] .lb__panel { transform: none; }
  .lb__panel:focus { outline: none; }

  .lb__bar { display: flex; justify-content: flex-end; }

  .lb__close,
  .lb__nav {
    background: none;
    border: 0;
    color: #e7e5e1;
    cursor: pointer;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding-inline: 0.25rem;
  }
  .lb__close-label {
    border-bottom: 1px solid #6b6f75;
    padding-bottom: 0.18em;
  }
  .lb__close:hover .lb__close-label { border-color: #e7e5e1; }

  .lb__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
    padding-block: clamp(0.5rem, 2vw, 1.25rem);
  }
  .lb__figure { width: 100%; }

  .lb__figure {
    margin: 0;
    height: 100%;
    display: grid;
    place-items: center;
    min-height: 0;
  }
  /* --natural-w is set per slide. A viewer that shows a smaller picture than
     the page is useless, so allow a modest 1.35x — beyond that these masters
     have nothing left to give. */
  .lb__figure img {
    width: min(100%, calc(var(--natural-w, 100%) * 1.35));
    max-height: 100%;
    height: auto;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .lb__figure img[data-ready] { opacity: 1; }

  .lb__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid #24262a;
  }

  .lb__meta { display: grid; gap: 0.2rem; min-width: 0; }
  .lb__caption {
    font-family: var(--serif);
    font-size: clamp(1.0625rem, 2.4vw, 1.375rem);
    font-weight: 300;
    color: #f2f0ec;
    letter-spacing: -0.01em;
  }
  .lb__note { font-size: 0.8125rem; color: #9a9da2; max-width: 42rem; }

  .lb__controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  /* A phone turned sideways is the shape a photograph is usually taken in, and
     it is how anyone looks at a landscape frame properly. Stacking the caption
     under the picture there spends a third of the screen on two lines of text,
     so it moves into a column beside it and the photograph gets the height. */
  @media (max-height: 30rem) and (min-aspect-ratio: 1 / 1) {
    .lb__panel {
      grid-template-rows: minmax(0, 1fr);
      grid-template-columns: minmax(0, 1fr) minmax(0, 14rem);
      column-gap: clamp(1rem, 3vw, 2rem);
      padding-block: 0.5rem;
    }
    .lb__bar {
      position: absolute;
      top: 0.25rem;
      right: clamp(0.75rem, 3vw, 2rem);
      z-index: 1;
    }
    .lb__stage { grid-column: 1; padding-block: 0; }
    .lb__foot {
      grid-column: 2;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 0.75rem;
      border-top: 0;
      padding-top: 2.75rem;
      padding-bottom: 0.5rem;
    }
    .lb__controls { margin-left: 0; }
  }
  .lb__nav { font-size: 1rem; color: #a9acb1; min-width: 2.75rem; justify-content: center; }
  .lb__nav:hover { color: #fff; }
  .lb__count {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: #c6c8ca;
    font-variant-numeric: tabular-nums;
    min-width: 4.5em;
    text-align: center;
  }
</style>
