---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { gallery, buildRows } from '../data/gallery';

const rows = buildRows(gallery);

// Stable index across the whole gallery so the lightbox can step through it.
// `sizes` is derived from each frame's share of its row, because in a justified
// row a landscape frame takes far more of the measure than a portrait one — a
// single flat value under-declares for one and over-declares for the other.
const MAX_CONTENT = 1320;

let cursor = 0;
const indexed = rows.map((row) => ({
  ...row,
  items: row.items.map((photo) => {
    const share = row.kind === 'lead' ? 1 : photo.ratio / row.span;
    const sizes =
      row.kind === 'lead'
        ? '(min-width: 48rem) 30rem, calc(100vw - 2.5rem)'
        : [
            `(min-width: 82.5rem) ${Math.round(share * MAX_CONTENT)}px`,
            `(min-width: 40rem) ${Math.round(share * 92)}vw`,
            'calc(100vw - 2.5rem)',
          ].join(', ');
    const ladder = [240, 320, 400, 480, 600, 800, photo.image.width]
      .filter((w) => w <= photo.image.width)
      .filter((w, i, all) => all.indexOf(w) === i);
    return { photo, index: cursor++, sizes, widths: ladder };
  }),
}));
---

<section class="section rule-top" id="journal" aria-labelledby="journal-title">
  <div class="shell">
    <SectionHead section="journal" title="A day, in the order it happened.">
      <p class="prose">
        Photographed on a small camera between sessions. No staging, no press pass — the
        arrival, the empty room, the boards people leave behind, and the twenty minutes
        where the actual conference happens, which is to say the coffee.
      </p>
    </SectionHead>
  </div>

  <div class="shell journal__body">
    {indexed.map((row) => (
      <div class={`jrow jrow--${row.kind}`} style={`--fill:${row.fill}`}>
        {row.items.map(({ photo, index, sizes, widths }) => (
          <figure
            class="shot reveal"
            style={`--grow:${(photo.ratio * 4).toFixed(3)};--master-w:${photo.image.width}px`}
          >
            <button
              class="shot__btn"
              type="button"
              data-lightbox={index}
              aria-label={`Open larger — ${photo.caption}. ${photo.alt}`}
            >
              <span class="frame shot__frame" style={`aspect-ratio:${photo.image.width} / ${photo.image.height}`}>
                <Image
                  src={photo.image}
                  alt={photo.alt}
                  widths={widths}
                  sizes={sizes}
                  quality={82}
                  loading="lazy"
                />
              </span>
            </button>
            <figcaption class="shot__cap balance">
              {photo.caption}
              {row.kind === 'lead' && photo.note && <span class="shot__note">{photo.note}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .journal__body {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
  }

  /* Phones get one frame per row. Two-up needs a minimum width to force the
     wrap, and that minimum overrides the ratio-proportional widths, so the
     frames in a pair stop sharing a height — the whole premise of the row. */
  .jrow { display: grid; gap: clamp(2rem, 6vw, 3rem); }
  .shot { margin: 0; }

  @media (min-width: 40rem) {
    .jrow {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      column-gap: clamp(0.75rem, 2vw, 1.5rem);
      row-gap: clamp(2rem, 4vw, 3.25rem);
    }
    /* flex-basis 0 + grow proportional to aspect ratio makes every frame in a
       line share one height. Ratios are scaled x4 so a lone item on a wrapped
       line still has grow >= 1 and fills the row. */
    .shot { flex: var(--grow) 1 0; min-width: 0; }
    .jrow--run { max-width: calc(100% * var(--fill)); }
    .jrow--lead .shot { flex: 0 1 100%; }
  }

  /* A plate is a photograph at its own resolution with its caption in the
     column beside it — never a stretched frame in a half-empty row. */
  @media (min-width: 48rem) {
    .jrow--lead { max-width: 50rem; }
    .jrow--lead .shot {
      flex: 1 1 100%;
      width: 100%;
      display: grid;
      grid-template-columns: min(30rem, var(--master-w)) minmax(0, 1fr);
      column-gap: clamp(1.75rem, 4vw, 3.5rem);
      align-items: end;
    }
    .jrow--lead .shot__btn { grid-column: 1; }
    .jrow--lead .shot__cap { grid-column: 2; margin-top: 0; padding-bottom: 0.35rem; }
  }
  .shot__note {
    display: block;
    margin-top: 0.4rem;
    color: var(--ink-3);
  }
  .shot__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .shot__frame { display: block; width: 100%; }
  .shot__frame :global(img) {
    transition: opacity 0.6s var(--ease), transform 0.9s var(--ease);
  }
  @media (hover: hover) {
    .shot__btn:hover .shot__frame :global(img) { transform: scale(1.018); opacity: 0.94; }
  }

  .shot__cap {
    margin-top: 0.65rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
