---
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { journalRows, journalContents, contentsDepth } from '../data/gallery';
import { journalDays, journalSpan, publishedAt } from '../data/photos';

const rows = journalRows;
/** A contents line, once the journal covers enough of the meeting to need one. */
const contents = journalContents;

// The headline follows the photographs: one day until Sunday's frames arrive.
const title =
  journalDays > 1 ? 'Two days, in the order they happened.' : 'A day, in the order it happened.';

// Stable index across the whole gallery so the lightbox can step through it.
// `sizes` is derived from each frame's share of its row, because in a justified
// row a landscape frame takes far more of the measure than a portrait one — a
// single flat value under-declares for one and over-declares for the other.
const MAX_CONTENT = 1320;
/** Nothing in the grid is ever laid out wider than ~880 CSS px, so a camera
 *  original is never encoded above what a 2x screen can actually use. */
const MAX_LADDER = 1800;
/** A plate is sized by height, so its width follows its shape. See the CSS. */
const PLATE_H = 480;

let cursor = 0;
const indexed = rows.map((row) => ({
  ...row,
  items: row.items.map((photo) => {
    const share = row.kind === 'lead' ? 1 : photo.ratio / row.span;
    // A plate runs to the viewport edges on a phone and is sized by height on
    // a wider screen, so a landscape plate asks for far more than a portrait one.
    const plateWidth = Math.round(Math.min(photo.image.width, photo.ratio * PLATE_H));
    const sizes =
      row.kind === 'lead'
        ? `(min-width: 48rem) ${plateWidth}px, 100vw`
        : [
            `(min-width: 82.5rem) ${Math.round(share * MAX_CONTENT)}px`,
            `(min-width: 40rem) ${Math.round(share * 92)}vw`,
            'calc(100vw - 2.5rem)',
          ].join(', ');
    const ceiling = Math.min(photo.image.width, MAX_LADDER);
    const ladder = [320, 480, 640, 900, 1250, ceiling]
      .filter((w) => w <= ceiling)
      .filter((w, i, all) => all.indexOf(w) === i);
    return { photo, index: cursor++, sizes, widths: ladder };
  }),
}));
---

<section class="section rule-top" id="journal" aria-labelledby="journal-title">
  <div class="shell">
    <SectionHead section="journal" title={title}>
      <p class="prose">
        Photographed on a small camera between sessions. No staging, no press pass — the
        arrival, the empty room, the boards people leave behind, and the twenty minutes
        where the actual conference happens, which is to say the coffee.
      </p>
      {journalSpan && (
        <p class="journal__span">
          {journalSpan}
          {publishedAt && <> · Last added {publishedAt}</>}
        </p>
      )}
      {contentsDepth > 2 && (
        <nav class="contents" aria-label="Jump to a part of the meeting">
          <ol>
            {contents.map((day) => (
              <li class="contents__day">
                <span class="contents__label label">{day.day}</span>
                <ul class="contents__parts">
                  {day.parts.map((part) => (
                    <li><a href={`#${part.id}`}>{part.label}</a></li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </SectionHead>
  </div>

  <div class="shell journal__body">
    {indexed.length === 0 && (
      <p class="journal__empty">
        No photographs yet. Drop them into the <code>photos</code> folder and they appear here.
      </p>
    )}
    {indexed.map((row) => (
      <div class={`jrow jrow--${row.kind}`} style={`--fill:${row.fill}`}>
        {row.bucket && (
          <h3 class="jrow__bucket label" id={row.bucketId}>{row.bucket}</h3>
        )}
        {row.items.map(({ photo, index, sizes, widths }) => (
          <figure
            class="shot reveal"
            id={`photo-${photo.id}`}
            style={`--grow:${(photo.ratio * 4).toFixed(3)};--ratio:${photo.ratio.toFixed(4)};--master-w:${photo.image.width}px`}
          >
            <button
              class="shot__btn"
              type="button"
              data-lightbox={index}
              aria-label={[
                'Open larger —',
                // Captions end in their own full stop; a second one is read out.
                photo.caption && (/[.!?”]$/.test(photo.caption) ? photo.caption : `${photo.caption}.`),
                photo.alt,
              ].filter(Boolean).join(' ')}
            >
              <span class="frame shot__frame" style={`aspect-ratio:${photo.image.width} / ${photo.image.height}`}>
                <Image
                  src={photo.image}
                  alt={photo.alt}
                  widths={widths}
                  sizes={sizes}
                  quality={82}
                  loading="lazy"
                />
              </span>
            </button>
            {(photo.caption || (row.kind === 'lead' && photo.note)) && (
              <figcaption class="shot__cap balance">
                {photo.caption}
                {row.kind === 'lead' && photo.note && <span class="shot__note">{photo.note}</span>}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .journal__body {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
  }

  /* Phones get one frame per row. Two-up needs a minimum width to force the
     wrap, and that minimum overrides the ratio-proportional widths, so the
     frames in a pair stop sharing a height — the whole premise of the row. */
  .jrow { display: grid; gap: clamp(2rem, 6vw, 3rem); }
  .shot { margin: 0; }

  /* Where capture times exist the journal breaks itself into half-days. */
  .jrow__bucket {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: 0.35rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .journal__span {
    margin-top: 0.9rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  /* A contents line, the way a long feature carries one. A day and its halves
     is a line of type; four links each beginning "Saturday" is a list. */
  .contents { margin-top: 1.25rem; display: grid; gap: 0.35rem; }
  .contents__day {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.1rem;
  }
  .contents__label { min-width: 5.5rem; }
  .contents__parts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    font-size: 0.8125rem;
  }
  .contents a {
    color: var(--ink-2);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    box-shadow: inset 0 -1px 0 var(--rule-strong);
    transition: box-shadow 0.25s var(--ease), color 0.25s var(--ease);
  }
  .contents a:hover { color: var(--pine); box-shadow: inset 0 -1px 0 var(--pine); }

  .journal__empty {
    color: var(--ink-3);
    font-size: 0.9375rem;
    padding-block: 2rem;
  }
  .journal__empty code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.875em;
    background: var(--paper-sunk);
    padding: 0.1em 0.35em;
  }

  @media (min-width: 40rem) {
    .jrow__bucket { flex-basis: 100%; }
    .jrow {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      column-gap: clamp(0.75rem, 2vw, 1.5rem);
      row-gap: clamp(2rem, 4vw, 3.25rem);
    }
    /* flex-basis 0 + grow proportional to aspect ratio makes every frame in a
       line share one height. Ratios are scaled x4 so a lone item on a wrapped
       line still has grow >= 1 and fills the row. */
    .shot { flex: var(--grow) 1 0; min-width: 0; }
    .jrow--run { max-width: calc(100% * var(--fill)); }
    .jrow--lead .shot { flex: 0 1 100%; }
  }

  /* On a phone a plate is the one frame allowed to touch the edges of the
     page. It is the only hierarchy a single-column layout has, and used once
     every eight or nine frames it reads as punctuation rather than decoration. */
  @media (max-width: 39.999rem) {
    .jrow--lead { margin-block: clamp(0.5rem, 3vw, 1.5rem); }
    .jrow--lead .shot__btn {
      margin-inline: calc(50% - 50vw);
      width: 100vw;
    }
    .jrow--lead .shot__cap { padding-top: 0.15rem; }
  }

  /* A plate is sized by height, the way a picture editor sizes one: a
     landscape frame runs wide and a portrait frame runs narrow, and both sit
     in the same band of the page. Never a stretched frame in a half-empty row. */
  @media (min-width: 48rem) {
    .jrow--lead { --plate-h: clamp(19rem, 34vw, 30rem); }
    .jrow--lead .shot {
      flex: 1 1 100%;
      width: 100%;
      display: grid;
      grid-template-columns:
        min(100%, var(--master-w), calc(var(--plate-h) * var(--ratio)))
        minmax(0, 1fr);
      column-gap: clamp(1.75rem, 4vw, 3.5rem);
      align-items: end;
    }
    .jrow--lead .shot__btn { grid-column: 1; }
    /* The caption goes to the far edge of the measure rather than sitting
       against the frame, so the air between them is a line across the page
       instead of a hole beside a photograph. */
    .jrow--lead .shot__cap {
      grid-column: 2;
      justify-self: end;
      max-width: 18rem;
      width: 100%;
      margin-top: 0;
      padding-top: 0.6rem;
      padding-bottom: 0.35rem;
      border-top: 1px solid var(--rule);
    }
  }
  .shot__note {
    display: block;
    margin-top: 0.4rem;
    color: var(--ink-3);
  }
  .shot__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .shot__frame { display: block; width: 100%; }
  .shot__frame :global(img) {
    transition: opacity 0.6s var(--ease), transform 0.9s var(--ease);
  }
  @media (hover: hover) {
    .shot__btn:hover .shot__frame :global(img) { transform: scale(1.018); opacity: 0.94; }
  }

  .shot__cap {
    margin-top: 0.65rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
</style>
