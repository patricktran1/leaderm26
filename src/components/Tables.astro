---
import SectionHead from './SectionHead.astro';
import { tables } from '../data/tables';
---

<section class="section rule-top" id="tables">
  <div class="shell">
    <SectionHead num="03" label="Twenty tables" title="Twenty tables. Twenty questions worth sitting down for.">
      <p class="prose">
        Lunch is not lunch. Each table carries a host and a single question, printed on a board
        by the door, and you pick the conversation you want to be in. It is the quietly radical
        part of the format: one room, split into twenty conversations instead of one broadcast.
      </p>
      <p class="prose tables__source">Transcribed on site from the printed board.</p>
    </SectionHead>

    <ol class="tables">
      {tables.map((t, i) => (
        <li class="tables__row reveal" style={`--reveal-delay:${Math.min(i, 8) * 25}ms`}>
          <span class="tables__num">{String(t.table).padStart(2, '0')}</span>
          <span class="tables__theme">{t.theme}</span>
          <span class="tables__host">{t.host}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .tables__source { font-size: 0.75rem !important; color: var(--ink-3); margin-top: 0.9rem; }
  .tables__source :global(p) { font-size: 0.75rem; }

  .tables {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-top: 1px solid var(--ink);
    display: grid;
  }
  @media (min-width: 62rem) {
    .tables {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2.5rem, 5vw, 5rem);
    }
    /* Keep the rule continuous across both columns. */
    .tables__row:nth-child(10) { border-bottom: 1px solid var(--rule); }
  }

  .tables__row {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    grid-template-areas: 'num theme' '. host';
    column-gap: 0.75rem;
    row-gap: 0.2rem;
    padding-block: clamp(0.85rem, 1.8vw, 1.15rem);
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  @media (min-width: 48rem) {
    .tables__row {
      grid-template-columns: 2.5rem minmax(0, 1fr) 11rem;
      grid-template-areas: 'num theme host';
      column-gap: 1.25rem;
    }
  }
  @media (min-width: 62rem) {
    .tables__row { grid-template-columns: 2.5rem minmax(0, 1fr) 9.5rem; }
  }

  .tables__num {
    grid-area: num;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .tables__theme {
    grid-area: theme;
    font-family: var(--serif);
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }
  .tables__host {
    grid-area: host;
    font-size: 0.75rem;
    color: var(--ink-3);
    line-height: 1.4;
  }
  @media (min-width: 48rem) {
    .tables__host { text-align: right; }
  }
</style>
