---
import { conference, author, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="shell foot__inner">
    <div class="foot__brand">
      <span class="foot__mark">LEAD<span>derm</span> 2026 · Field Notes</span>
      <span class="foot__sub">{site.tagline}. Photographs © {year} {author.short}.</span>
    </div>
    <div class="foot__links">
      <a class="foot__link" href={conference.official} target="_blank" rel="noopener noreferrer"
        ><span class="link">leadderm.org</span></a
      >
      <a class="foot__link" href={`mailto:${author.email}`}><span class="link">{author.email}</span></a>
      <a class="foot__link" href={author.instagramUrl} target="_blank" rel="noopener noreferrer"
        ><span class="link">@{author.instagram}</span></a
      >
    </div>
  </div>
  <div class="shell">
    <div class="foot__fine">
      <span>{conference.venue} · {conference.dates}</span>
      <a class="foot__top" href="/#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .foot { padding-block: 0 2rem; position: relative; }
  .foot > .shell:first-child { position: relative; padding-block-start: clamp(2.5rem, 5vw, 4rem); }
  .foot > .shell:first-child::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--gutter);
    right: var(--gutter);
    border-top: 1px solid var(--ink);
  }
  .foot__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  @media (min-width: 48rem) {
    .foot__inner { grid-template-columns: minmax(0, 1fr) auto; align-items: start; }
  }
  .foot__brand { display: grid; gap: 0.5rem; }
  .foot__mark { font-size: 0.9375rem; font-weight: 600; letter-spacing: 0.02em; }
  .foot__mark span { font-weight: 400; color: var(--ink-2); }
  .foot__sub {
    font-size: 0.8125rem;
    color: var(--ink-3);
    max-width: 34rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .foot__links { display: grid; font-size: 0.8125rem; justify-items: start; }
  /* The anchor carries the touch target; the span carries the underline, so
     the rule stays tight to the text. */
  .foot__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }
  @media (min-width: 48rem) { .foot__links { justify-items: end; } }

  .foot__fine {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--ink-3);
  }
  /* inline-flex drops the whitespace-only run between the label and the
     glyph, so the gap has to be declared. */
  .foot__top {
    text-decoration: none;
    color: var(--ink-3);
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 2.75rem;
  }
  .foot__top:hover { color: var(--ink); }
</style>
