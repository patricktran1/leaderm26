---
import SectionHead from './SectionHead.astro';
import { author } from '../data/site';

const lines = [
  {
    k: 'Presence',
    v: 'A site that reads like your practice at its best. Real photography, real typography, and the restraint to leave the rest out.',
  },
  {
    k: 'Operations',
    v: 'Intake, triage, recall and follow-up wired so the front desk stops re-typing what a form already knows.',
  },
  {
    k: 'Intelligence',
    v: 'Language models put where they are genuinely good: drafting, summarizing, routing. Kept well away from clinical judgement.',
  },
];
---

<section class="section rule-top" id="practice" aria-labelledby="practice-title">
  <div class="shell">
    <SectionHead section="practice" title="The same thinking, for a practice.">
      <p class="prose">
        This page is the demonstration. It was designed and built during the conference it
        documents, on the same principles a practice site would use: photography that is
        actually yours, type that holds up, and a page that opens fast on hotel Wi-Fi.
      </p>
      <p class="prose">
        Every photograph here was published by dropping a file into a folder. Rotation,
        ordering by the time each frame was taken, the dividers between one half-day and the
        next, the link preview — all of it happens without anyone being asked to do anything.
        That is what good automation looks like from the inside: not a dashboard, just work
        that stopped needing to be done.
      </p>
    </SectionHead>

    <dl class="capability">
      {lines.map((l, i) => (
        <div class="capability__row reveal" style={`--reveal-delay:${i * 70}ms`}>
          <dt class="capability__k">{l.k}</dt>
          <dd class="capability__v">{l.v}</dd>
        </div>
      ))}
    </dl>

    <div class="invite reveal">
      <p class="serif-note invite__line">
        If you are building something for a practice, a department or a meeting,
        I would like to hear about it.
      </p>
      <div class="invite__links">
        <a class="arrow-link" href={`mailto:${author.email}?subject=From%20LEADderm%202026`}>
          <span>{author.email}</span> <span class="chev" aria-hidden="true">→</span>
        </a>
        <a class="arrow-link" href={author.instagramUrl} target="_blank" rel="noopener noreferrer">
          <span>@{author.instagram}</span> <span class="chev" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .capability {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--ink);
    max-width: 50rem;
  }
  .capability__row {
    display: grid;
    gap: 0.4rem;
    padding-block: clamp(1.25rem, 2.6vw, 1.75rem);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 48rem) {
    .capability__row {
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: clamp(1.5rem, 3vw, 2.5rem);
      align-items: baseline;
    }
  }
  .capability__k {
    font-family: var(--serif);
    font-size: clamp(1.125rem, 1.7vw, 1.375rem);
    font-weight: 400;
    letter-spacing: -0.012em;
  }
  .capability__v {
    font-size: 0.9375rem;
    line-height: 1.68;
    color: var(--ink-2);
    max-width: 38rem;
    text-wrap: balance;
  }

  .invite {
    margin-top: clamp(3rem, 7vw, 5rem);
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    justify-items: start;
  }
  .invite__line { max-width: 32rem; text-wrap: balance; }
  .invite__links { display: grid; gap: 0.25rem; justify-items: start; }
</style>
