---
import SectionHead from './SectionHead.astro';

const notes = [
  {
    title: 'The room is the argument',
    body: `Twenty round tables and a low stage. No auditorium rake, no back row to hide in,
    no seat far from a faculty member. You can read a conference's real thesis off its floor
    plan, and this one says the learning happens sideways.`,
  },
  {
    title: 'Values before tactics',
    body: `The programming keeps returning to the same order of operations: work out what
    you actually value, then choose the practice, the partners and the technology. Most of
    medicine's business advice runs that backwards.`,
  },
  {
    title: 'Technology as a management question',
    body: `Artificial intelligence turns up on the agenda not as a product demo but as a
    question about training, about how a team is built, about the shape of a patient's visit.
    That is a more useful frame than another tool comparison.`,
  },
];
---

<section class="section on-night" id="notes" aria-labelledby="notes-title">
  <div class="shell">
    <SectionHead section="notes" title="Three things worth writing down.">
      <p class="prose">
        What follows is opinion — one attendee's reading of the room, not reporting.
      </p>
    </SectionHead>

    <figure class="pull reveal">
      <blockquote>
        <p class="pull__line">
          Leadership isn’t always quiet. Sometimes the best ideas make a little noise.
        </p>
      </blockquote>
      <figcaption class="pull__source">
        Printed on the entrepreneurship table, beside a bowl of Pop Rocks
      </figcaption>
    </figure>

    <ol class="notes__row">
      {notes.map((note, i) => (
        <li class="note reveal" style={`--reveal-delay:${i * 80}ms`}>
          <span class="label note__n">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h3 note__t balance">{note.title}</h3>
          <p class="note__b">{note.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pull {
    margin: clamp(3rem, 8vw, 6rem) 0 clamp(3rem, 7vw, 5rem);
    max-width: 46rem;
  }
  .pull blockquote { margin: 0; }
  .pull__line {
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.75rem, 4.6vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.022em;
    color: var(--ink-on-night);
    text-wrap: balance;
  }
  .pull__source {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    padding-left: 1rem;
    border-left: 1px solid var(--pine-bright);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #9a9da2;
    max-width: 30rem;
  }

  .notes__row {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule-on-night);
  }
  @media (min-width: 54rem) {
    .notes__row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1.75rem, 4vw, 3.5rem);
    }
  }
  .note {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--rule-on-night);
  }
  .note__n { color: var(--ink-2-on-night); }
  .note__t { color: var(--ink-on-night); }
  .note__b {
    font-size: 0.9375rem;
    line-height: 1.68;
    color: var(--ink-2-on-night);
  }
</style>
