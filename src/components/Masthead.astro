---
import { sections, sectionNumber, conference } from '../data/site';
import { journalContents, contentsDepth } from '../data/gallery';

interface Props {
  /**
   * `plain` is for pages that are not the journal. The section index belongs
   * to the journal's own scroll, so away from it the bar carries the wordmark
   * and one way back, and nothing else.
   */
  variant?: 'journal' | 'plain';
}
const { variant = 'journal' } = Astro.props;
const isJournal = variant === 'journal';

/**
 * On a phone the journal is the longest thing on the site by an order of
 * magnitude, so the index that is already there becomes its table of contents
 * too — the only way back to Sunday morning from forty screens down.
 */
const showParts = contentsDepth > 2;
---

<header class:list={['masthead', { 'masthead--plain': !isJournal }]} id="masthead">
  <div class="shell masthead__inner">
    <a class="wordmark" href="/#top">
      <span class="wordmark__mark">LEAD<span class="wordmark__soft">derm</span> 2026</span>
      <span class="wordmark__sub">Field Notes</span>
    </a>

    {isJournal && (
      <nav class="masthead__nav" aria-label="Sections">
        {sections.map((item) => (
          <a href={`/#${item.id}`} data-spy={item.id}>{item.label}</a>
        ))}
      </nav>
    )}

    {isJournal ? (
      <a class="masthead__official" href={conference.official} target="_blank" rel="noopener noreferrer">
        Official site <span aria-hidden="true">↗</span>
      </a>
    ) : (
      <a class="masthead__back" href="/#top">
        <span aria-hidden="true">←</span> The journal
      </a>
    )}

    {isJournal && (
      <button class="masthead__toggle" type="button" aria-expanded="false" aria-controls="index-panel" data-menu-open>
        <span>Index</span>
      </button>
    )}
  </div>
</header>

{isJournal && (
<div class="index-panel" id="index-panel" role="dialog" aria-modal="true" aria-label="Index" hidden>
  <div class="shell index-panel__inner">
    <div class="index-panel__top">
      <span class="label">Index</span>
      <button class="index-panel__close" type="button" data-menu-close><span>Close</span></button>
    </div>
    <nav class="index-panel__nav" aria-label="Index">
      <ol class="index-panel__list">
        {sections.map((item) => (
          <li>
            <a href={`/#${item.id}`} data-menu-link data-spy={item.id}>
              <span class="index-panel__num">{sectionNumber(item.id)}</span>
              <span>{item.label}</span>
            </a>
            {item.id === 'journal' && showParts && (
              <ul class="index-panel__parts">
                {journalContents.map((day) => (
                  <li>
                    <span class="index-panel__day label">{day.day}</span>
                    {day.parts.map((part) => (
                      <a href={`/#${part.id}`} data-menu-link>{part.label}</a>
                    ))}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </nav>
    <div class="index-panel__foot">
      <p class="index-panel__where">{conference.venue} · {conference.dates}</p>
      <a class="index-panel__official" href={conference.official} target="_blank" rel="noopener noreferrer">
        leadderm.org <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</div>
)}

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color 0.35s var(--ease);
  }
  .masthead[data-scrolled] { border-bottom-color: var(--rule); }

  .masthead__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.75rem;
  }

  .wordmark {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.75rem;
  }
  .wordmark__mark {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .wordmark__soft { font-weight: 400; color: var(--ink-2); }
  .wordmark__sub {
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-left: 0.6rem;
    border-left: 1px solid var(--rule);
  }

  .masthead__nav { display: none; gap: clamp(1.1rem, 2.2vw, 2rem); }
  .masthead__nav a {
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.4rem;
    transition: color 0.25s var(--ease);
  }
  .masthead__nav a:hover { color: var(--ink); }
  .masthead__nav a[data-current] {
    color: var(--ink);
    box-shadow: inset 0 -1px 0 var(--ink);
  }

  .masthead__official {
    display: none;
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s var(--ease);
  }
  .masthead__official:hover { color: var(--pine); }

  /* Always shown: away from the journal this is the only navigation there is,
     so it must not be the thing that disappears on a phone. */
  .masthead__back {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    min-height: 2.75rem;
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.25s var(--ease);
  }
  .masthead__back:hover { color: var(--pine); }
  /* Two items share the bar here rather than one, so the standfirst goes. */
  @media (max-width: 26rem) {
    .masthead--plain .wordmark__sub { display: none; }
  }
  /* A page with no section index has nothing for a sticky bar to do, and a
     paper bar riding over a full-height ink section is a band across the
     design. It scrolls away with everything else. */
  .masthead--plain { position: static; }

  .masthead__toggle,
  .index-panel__close {
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    color: var(--ink);
  }

  @media (min-width: 62rem) {
    .masthead__nav { display: flex; }
    .masthead__official { display: block; }
    .masthead__toggle { display: none; }
    .masthead__inner { min-height: 4.25rem; }
  }

  /* --- full screen index --- */
  .index-panel {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: var(--paper);
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .index-panel[data-open] { opacity: 1; }
  .index-panel[hidden] { display: none; }

  .index-panel__inner {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-block: 1rem 3rem;
  }
  .index-panel__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .masthead__toggle > span,
  .index-panel__close > span {
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.18em;
  }
  .index-panel__nav { flex: 1; display: flex; align-items: flex-start; padding-top: clamp(1.5rem, 5vw, 3rem); }
  .index-panel__list { width: 100%; display: grid; }
  .index-panel__list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: clamp(0.7rem, 2.4vw, 1.1rem);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(1.75rem, 8vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .index-panel__parts {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .index-panel__parts > li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.1rem;
  }
  .index-panel__day { min-width: 5.5rem; }
  .index-panel__parts a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding-block: 0;
    border-bottom: 0;
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink-2);
    text-decoration: none;
  }
  .index-panel__parts a:hover { color: var(--pine); }
  .index-panel__num {
    font-family: var(--sans);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: var(--ink-3);
  }
  .index-panel__list a[data-current] .index-panel__num { color: var(--pine); }
  .index-panel__foot {
    margin-top: auto;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 0.25rem;
  }
  .index-panel__where {
    padding-top: 1rem;
    font-size: 0.8125rem;
    color: var(--ink-3);
  }
  .index-panel__official {
    padding-top: 0;
    min-height: 2.75rem;
    display: inline-flex;
    gap: 0.4em;
    align-items: flex-end;
    align-self: flex-start;
    font-size: 0.8125rem;
    color: var(--ink-2);
    text-decoration: none;
  }
</style>
