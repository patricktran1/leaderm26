---
import { sectionNumber, sectionLabel, type SectionId } from '../data/site';

interface Props {
  /** A section of the journal: its numeral and label come from site.ts. */
  section?: SectionId;
  /** For pages outside the journal, which run their own sequence. */
  num?: string;
  label?: string;
  id?: string;
  title: string;
  /** `quiet` sets the heading at text scale — for sections that should not
      compete with the journal, such as the colophon. */
  scale?: 'display' | 'quiet';
}
const props = Astro.props;
const { section, title, scale = 'display' } = props;
const num = props.num ?? (section ? sectionNumber(section) : '');
const label = props.label ?? (section ? sectionLabel(section) : '');
const headingId = `${props.id ?? section}-title`;
---

<div class="sec-head">
  <div class="sec-head__index reveal">
    <span class="sec-head__num">{num}</span>
    <span class="label">{label}</span>
  </div>
  <div class="sec-head__body">
    <h2
      class:list={[scale === 'quiet' ? 'h2--quiet' : 'h2', 'balance', 'reveal']}
      id={headingId}
      style="--reveal-delay:60ms"
    >
      {title}
    </h2>
    <div class="sec-head__aside reveal" style="--reveal-delay:120ms"><slot /></div>
  </div>
</div>

<style>
  .sec-head__aside:empty { display: none; }
  .h2--quiet {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.5rem, 2.4vw, 2.125rem);
    line-height: 1.2;
    letter-spacing: -0.012em;
  }
  .sec-head__aside { margin-top: clamp(1.25rem, 2.5vw, 2rem); }
</style>
